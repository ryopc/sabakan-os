# SabakanOS レーンA — Buildroot 設定
# アーキテクチャ: x86_64 / C ライブラリ: musl / 構成: 最小
#
# 使用例 (Buildroot ソースディレクトリで):
#   make BR2_DEFCONFIG=../../config/buildroot-defconfig defconfig
#   make

BR2_x86_64=y
BR2_x86_core2=y
BR2_ARCH="x86_64"
BR2_ENDIAN="LITTLE"
BR2_GCC_TARGET_ARCH="x86-64"
BR2_LARGEFILE=y

# ツールチェイン: Buildroot 製 musl ツールチェイン
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_USES_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_HAS_THREADS=y
BR2_TOOLCHAIN_HAS_THREADS_DEBUG=y
BR2_TOOLCHAIN_HAS_SSP=y
BR2_TOOLCHAIN_HAS_UCONTEXT=y
BR2_TOOLCHAIN_HAS_MMX=y
BR2_TOOLCHAIN_HAS_SYNC=y
BR2_TOOLCHAIN_HAS_C99=y
BR2_TOOLCHAIN_HAS_EXCEPTION=y
BR2_TOOLCHAIN_BUILDROOT_LOCALE=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# ベースパッケージ (最小)
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_DASH=y

# ターゲット: シリアルコンソール経由で getty
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# ルートFS 形式
BR2_TARGET_ROOTFS_TAR=y
