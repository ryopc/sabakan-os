# SabakanOS デスクトップメタパッケージレシピ (APKBUILD 形式 / apk 互換)
# 日本語フォント・IME・軽量WM を rootfs へインストールし、X11 環境を整備

# Maintainer: SabakanOS レーンC チーム <sabakan-os-lanec@example.com>
pkgname=sabakan-desktop
pkgver=1.0.0
pkgrel=1
pkgdesc="SabakanOS 日本語デスクトップ環境 (Noto CJK フォント, IBus+Mozc, Openbox)"
url="https://github.com/ryopc/sabakan-os"
arch="all"
license="MIT"
depends="font-noto-cjk ibus ibus-mozc openbox"
makedepends=""
install=""
subpackages=""

source=""
sha512sums=""

builddir="$srcdir"

# ソースなし (設定ファイルのみを直接インストール)
prepare() {
    return 0
}

build() {
    return 0
}

package() {
    # --- X11/日本語入力環境変数 (profile.d) ---
    mkdir -p "$pkgdir/etc/profile.d"
    cat > "$pkgdir/etc/profile.d/ibus.sh" <<'EOF'
# SabakanOS IBus + Mozc 日本語入力環境 (レーンC 配置)
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
EOF

    # --- X11 起動時 IBus デーモン起動 (.xprofile) ---
    mkdir -p "$pkgdir/etc/skel"
    cat > "$pkgdir/etc/skel/.xprofile" <<'EOF'
# SabakanOS X11 セッション起動スクリプト (レーンC 配置)
# IBus デーモンを起動して日本語入力を有効化
ibus-daemon -drx &
EOF
    chmod 755 "$pkgdir/etc/skel/.xprofile"

    # --- Openbox 設定ディレクトリ ---
    mkdir -p "$pkgdir/etc/xdg/openbox"
    cat > "$pkgdir/etc/xdg/openbox/autostart" <<'EOF'
# SabakanOS Openbox 自動起動スクリプト (レーンC 配置)
# 日本語入力デーモンを起動
ibus-daemon -drx &
EOF

    cat > "$pkgdir/etc/xdg/openbox/menu.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
    <menu id="root-menu" label="SabakanOS">
        <item label="ターミナル"><action name="Execute"><execute>xterm</execute></action></item>
        <item label="終了"><action name="Exit"/></item>
    </menu>
</openbox_menu>
EOF

    # --- X セッション設定 ---
    mkdir -p "$pkgdir/etc/X11/xinit"
    cat > "$pkgdir/etc/X11/xinit/xinitrc" <<'EOF'
#!/bin/sh
# SabakanOS X セッション初期化スクリプト (レーンC 配置)
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
ibus-daemon -drx &
exec openbox
EOF
    chmod 755 "$pkgdir/etc/X11/xinit/xinitrc"

    # --- デスクトップエントリディレクトリ ---
    mkdir -p "$pkgdir/usr/share/applications"
    mkdir -p "$pkgdir/usr/share/xsessions"
    cat > "$pkgdir/usr/share/xsessions/sabakan-openbox.desktop" <<'EOF'
[Desktop Entry]
Name=SabakanOS Openbox
Comment=Lightweight Japanese Desktop (Openbox + IBus + Mozc)
Exec=/etc/X11/xinit/xinitrc
TryExec=/usr/bin/openbox
Type=XSession
EOF
}
