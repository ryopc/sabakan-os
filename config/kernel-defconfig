# SabakanOS レーンA — Linux カーネル設定
# Linux LTS (x86_64) の defconfig をベースにした最小構成。
# 実際のビルドでは x86_64_defconfig を適用した上で、本ファイルの
# シンボルを olddefconfig で上書き・補完する。
#
# 使用例 (カーネルソースディレクトリで):
#   make ARCH=x86_64 defconfig
#   cat ../../config/kernel-defconfig >> .config
#   make ARCH=x86_64 olddefconfig

CONFIG_X86_64=y
CONFIG_64BIT=y
CONFIG_X86=y
CONFIG_X86_GENERIC=y
CONFIG_X86_INTERNODE_CACHE_SHIFT=6
CONFIG_X86_L1_CACHE_SHIFT=6
CONFIG_X86_TSC=y
CONFIG_X86_CMPXCHG64=y
CONFIG_X86_CMOV=y
CONFIG_X86_MINIMUM_CPU_FAMILY=64
CONFIG_X86_DEBUGCTLMSR=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_HPET_TIMER=y
CONFIG_HPET=y

CONFIG_PCI=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MMCONFIG=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y

CONFIG_PRINTK=y
CONFIG_CONSOLE=y
CONFIG_CONSOLE_SLEEP=y

CONFIG_MODULES=n
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y

CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_SMP=y
CONFIG_HZ_250=y
CONFIG_HZ=250

CONFIG_NET=n
